<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netcoreapp3.1;net5.0;net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<Title>Super Convert Files</Title>
		<Version>1.0.4.0</Version>
		<PackageId>SuperConvert.Files</PackageId>
		<Authors>SDN-X</Authors>
		<Company>SDN-X</Company>
		<RepositoryUrl>https://github.com/SDN-X/SuperConvert</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageProjectUrl>https://github.com/SDN-X/SuperConvert</PackageProjectUrl>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageTags>conversion;json;csv;xml;datatable;excel</PackageTags>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
		<Description>
			SuperConvert is an open-source lightweight package to convert your data in c#
			Convert between data containers, Json/Datatable/Excelsheets and other data tables
			Create some json strings / Data tables
			Convert between them
			Convert DateTime
			Convert Json ⇔ Csv
			Convert DataTable ⇔ Csv
			✨Magic ✨
		</Description>
		<PackageIcon>electric-generator.png</PackageIcon>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\assets\electric-generator.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\LICENSE.txt" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="SuperConvert" Version="1.0.5.2" />
	</ItemGroup>

</Project>